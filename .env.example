# Required: model id measured on THIS host (`muse exec --provider meta` / provider docs). No default.
MUSE_MODEL=

# Meta API credential for `muse exec` (keep out of git).
META_API_KEY=

# MUSE_BRIDGE_PORT=4320
# MUSE_BRIDGE_BIND=127.0.0.1
# MUSE_BRIDGE_HOME=~/.config/muse-bridge
# MUSE_BRIDGE_TOKEN_FILE=~/.config/muse-bridge/token
# MUSE_WS_BASE=~/.config/muse-bridge/workspaces
# MUSE_BIN=muse
# MUSE_PROVIDER=meta
# MUSE_REASONING_EFFORT=high
# BRIDGE_MUSE_STUB=0
